# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/prohori
SUPABASE_URL=
SUPABASE_KEY=

# AI Models — Nova (University AI gateway, PRIMARY)
NOVA_API_KEY=your_nova_api_key_here
NOVA_BASE_URL=https://nova.zohirrayhan.me/api/chat
# 'nova_c' is currently disabled gateway-side; 'nova_g' is the enabled model id.
NOVA_MODEL=nova_g

# AI Models — Groq (Fallback, FREE)
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# AI Models — Mistral (Fallback, FREE)
MISTRAL_API_KEY=your_mistral_key_here
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
TRIAGE_MODEL=gpt-4o-mini
PROSECUTOR_MODEL=gpt-4o
DEFENDER_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o

# Authentication
JWT_SECRET=your_jwt_secret_here_use_a_strong_random_string

# Security Configuration
MAX_PROMPT_LENGTH=10000
AUTO_BLOCK_THRESHOLD=0.90
DEBATE_THRESHOLD=0.70
RAG_SIMILARITY_THRESHOLD=0.80

# Rate Limiting
REQUESTS_PER_MINUTE=60
DEBATES_PER_HOUR=100

# Environment
NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=INFO

# Optional Features
ENABLE_ML_CLASSIFIER=false
ENABLE_RAG_MEMORY=true
ENABLE_REAL_TIME_UPDATES=true
# Optional fallback providers (add your keys to enable)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SERPER_API_KEY=

